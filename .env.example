# =============================================================================
# E-COMMERCE PLATFORM — Environment Variables (Phase 2)
# Copy this file to `.env` for local dev, fill values from the linked dashboards.
# NEVER commit a real `.env` file. Secrets are injected by the host
# (Vercel env vars, GitHub Actions secrets, docker-compose `.env.local`).
# Convention: NEXT_PUBLIC_* are exposed to the browser, everything else is server-only.
# =============================================================================

# ---------- Runtime / App ---------------------------------------------------
# Node environment. "development" | "test" | "preview" | "staging" | "production"
NODE_ENV=development
# Public base URL of the running app. Used for absolute links, OG tags, OAuth callbacks.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Public canonical origin (no trailing slash). Differs per env (preview/staging/prod).
SITE_ORIGIN=http://localhost:3000
# ISO locale + timezone (defaults to fr-FR / Europe/Paris for the seed/test contract).
NEXT_PUBLIC_LOCALE=fr-FR
TZ=Europe/Paris
# Log level for the structured logger: trace | debug | info | warn | error
LOG_LEVEL=info

# ---------- Database (Neon Postgres) ----------------------------------------
# Pooled connection (PgBouncer-compatible, used at runtime). REQUIRED.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxx-pooler.eu-west-3.aws.neon.tech/neondb?sslmode=require
# Direct (non-pooled) connection used by migrations (Prisma migrate / Drizzle push).
# Optional but recommended: keep separate from the pooled URL.
DIRECT_URL=postgresql://USER:PASSWORD@ep-xxx.eu-west-3.aws.neon.tech/neondb?sslmode=require
# Region pinning for read replicas / latency. eu-west-3 = Paris. REQUIRED for RGPD scoping.
DATABASE_REGION=eu-west-3
# Statement timeout in ms (defense vs runaway queries). Optional.
DATABASE_STATEMENT_TIMEOUT_MS=15000

# ---------- Auth (Auth.js / NextAuth v5) ------------------------------------
# 32+ char random secret used to sign session JWTs. REQUIRED in every non-dev env.
# Generate: `openssl rand -base64 32`
AUTH_SECRET=replace_me_with_32_plus_chars_random
# Trust the host header. Required for Vercel preview URLs. "true" on Vercel.
AUTH_TRUST_HOST=true
# Canonical auth base URL (used for OAuth callbacks). Falls back to SITE_ORIGIN if unset.
AUTH_URL=http://localhost:3000
# Google OAuth provider (optional). Create credentials at https://console.cloud.google.com/apis/credentials
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# GitHub OAuth provider (optional).
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
# Magic-link email provider (Resend). Optional but recommended.
AUTH_EMAIL_FROM=no-reply@example.com

# ---------- Stripe (payments — MOCK MODE in Phase 2) ------------------------
# Server-side secret key. In Phase 2 use the documented mock value `sk_test_mock`.
# Real test keys start with `sk_test_` (https://dashboard.stripe.com/test/apikeys).
STRIPE_SECRET_KEY=sk_test_mock
# Publishable key (browser). Phase 2 mock: `pk_test_mock`.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_mock
# Signing secret for Stripe webhooks. Get it from `stripe listen` or the dashboard endpoint.
STRIPE_WEBHOOK_SECRET=whsec_mock
# Price ID lookup table (comma-separated key=value). Optional — falls back to a hardcoded map in code.
STRIPE_PRICE_STARTER=price_mock_starter
STRIPE_PRICE_PRO=price_mock_pro
# Currency for all charges. EUR for EU markets.
STRIPE_CURRENCY=eur
# API version pin. Prevents silent breaking changes on SDK upgrades.
STRIPE_API_VERSION=2024-06-20

# ---------- Redis / rate-limit (Upstash) ------------------------------------
# REST endpoint + token from the Upstash console (free tier).
# When unset locally, docker-compose provides Redis on localhost:6379.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Local fallback (used only when UPSTASH_* are empty). Set automatically by docker-compose.
REDIS_URL=redis://localhost:6379
# Rate-limit window/limit defaults. Optional, code-side fallback = 60 req/min/IP.
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=60

# ---------- Sentry (errors + performance) -----------------------------------
# Server-side DSN. Project Settings → Client Keys (DSN).
SENTRY_DSN=
# Browser DSN (same value is fine; kept separate so we can rotate independently).
NEXT_PUBLIC_SENTRY_DSN=
# Auth token for uploading source maps from CI. Settings → Auth Tokens.
SENTRY_AUTH_TOKEN=
# Org slug + project slug for `sentry-cli` releases. Required in CI only.
SENTRY_ORG=
SENTRY_PROJECT=
# Sample rate for performance traces (0.0–1.0). 0.1 in prod = 10% sampling.
SENTRY_TRACES_SAMPLE_RATE=0.1
# Send user PII (email, IP) to Sentry? Default false for RGPD.
SENTRY_SEND_DEFAULT_PII=false

# ---------- Resend (transactional email) -------------------------------------
# API key from https://resend.com/api-keys
RESEND_API_KEY=
# Verified sender (domain must be verified in Resend dashboard in prod).
RESEND_FROM_EMAIL=no-reply@example.com
# Reply-to address shown to recipients.
RESEND_REPLY_TO=support@example.com

# ---------- Cloudflare R2 (object storage — backups + large assets) ---------
# Account ID from the Cloudflare dashboard sidebar.
CLOUDFLARE_ACCOUNT_ID=
# R2 access key pair (R2 → Manage R2 API Tokens). Treat as write-capable.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Bucket name (created in R2 dashboard). Convention: `ecommerce-prod-backups` etc.
R2_BUCKET=ecommerce-dev-backups
# Public CDN URL bound to the bucket (Workers + R2 public bucket or custom domain).
R2_PUBLIC_URL=
# Optional endpoint override (defaults to https://<ACCOUNT_ID>.r2.cloudflarestorage.com).
R2_ENDPOINT=

# ---------- Cloudflare (DNS / WAF / Turnstile) ------------------------------
# Zone ID for the production domain. DNS / Cache / Workers KV bindings use it.
CLOUDFLARE_ZONE_ID=
# API token with `Zone.DNS:Edit` + `Zone.WAF:Edit` scopes. NEVER log this.
CLOUDFLARE_API_TOKEN=
# Turnstile site key (public) + secret (server). Public site key shown in widget.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ---------- Feature flags / experimental ------------------------------------
# Toggle non-critical features without redeploying. Comma-separated.
ENABLED_FLAGS=
# Maintenance mode (kills writes, shows static page). "true" | "false".
MAINTENANCE_MODE=false

# ---------- Seed / dev-only -------------------------------------------------
# Bootstrap admin created by `pnpm seed`. NEVER set in prod.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=admin_dev_only_change_me
# Stripe test card used by Playwright e2e. Safe to commit.
SEED_STRIPE_TEST_CARD=4242424242424242
