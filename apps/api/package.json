{
  "name": "@ecommerce/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "lint": "eslint src --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "echo 'no e2e in api' && exit 0",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@ecommerce/db": "workspace:*",
    "@ecommerce/shared": "workspace:*",
    "@hono/node-server": "^1.11.0",
    "@hono/zod-openapi": "^0.16.0",
    "@hono/zod-validator": "^0.2.0",
    "@upstash/ratelimit": "^2.0.0",
    "@upstash/redis": "^1.34.0",
    "@aws-sdk/client-s3": "^3.600.0",
    "@aws-sdk/s3-request-presigner": "^3.600.0",
    "dotenv": "^16.4.5",
    "hono": "^4.4.0",
    "jose": "^5.4.0",
    "nanoid": "^5.0.7",
    "pino": "^9.3.0",
    "pino-http": "^10.0.0",
    "resend": "^3.4.0",
    "stripe": "^16.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.30",
    "eslint": "^9.0.0",
    "testcontainers": "^10.10.0",
    "tsx": "^4.11.0",
    "typescript": "^5.4.5",
    "vitest": "^1.6.0"
  }
}
